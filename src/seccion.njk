---
layout: layouts/base.njk
pagination:
  data: categorias
  size: 1
  alias: categoria
permalink: "/seccion/{{ categoria.slug }}/"
eleventyComputed:
  title: "{{ categoria.nombre }}"
  description: "Todas las noticias de {{ categoria.nombre }} en {{ site.nombre }} {{ site.frecuencia }}, La Cruz, Corrientes."
---
{% import "partials/macros.njk" as m %}
{% set notas = collections.noticias | porCategoria(categoria.slug) %}

<div class="container portal-layout">
  <div>
    <h1 class="section-title">{{ categoria.nombre }}</h1>
    {% if notas.length %}
      <div class="news-grid">
        {% for post in notas %}{{ m.articleCard(post) }}{% endfor %}
      </div>
    {% else %}
      <p class="empty-state">Todavía no hay noticias publicadas en {{ categoria.nombre }}. Cargá la primera desde <a href="/admin/">/admin</a>.</p>
    {% endif %}
  </div>
  {% include "partials/sidebar.njk" %}
</div>
