<div class="player-bar" role="region" aria-label="Reproductor de radio en vivo">
  <div class="container">
    <button id="player-toggle" class="player-toggle" type="button" aria-pressed="false" aria-label="Reproducir transmisión en vivo">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    </button>
    <div class="player-meta">
      <div class="station">{{ site.nombre }} {{ site.frecuencia }} · La Cruz, Corrientes</div>
      <div class="status">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="status-text" id="player-status-text">En pausa</span>
        <span class="player-error" id="player-error" role="status"></span>
      </div>
    </div>
    <div class="player-mini-wave" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="player-volume">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9H4z"/></svg>
      <label for="player-volume" class="visually-hidden">Volumen</label>
      <input type="range" id="player-volume" min="0" max="1" step="0.01" value="0.85">
    </div>
  </div>
  <audio id="radio-audio" preload="none"></audio>
</div>
