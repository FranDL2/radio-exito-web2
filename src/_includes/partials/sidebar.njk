<aside class="sidebar" aria-label="Contenido secundario">

  <div class="widget" id="clima-widget">
    <h2>El tiempo en La Cruz</h2>
    <div data-clima-body>
      <p class="dollar-fallback">Cargando el clima…</p>
    </div>
  </div>

  <div class="widget" id="dolar-widget">
    <h2>Cotización del dólar</h2>
    <div data-dolar-body>
      <p class="dollar-fallback">Cargando cotización…</p>
    </div>
  </div>

  {% set destacadasList = collections.noticias | destacadas | limitar(5) %}
  {% if destacadasList.length %}
  <div class="widget">
    <h2>Noticias destacadas</h2>
    <ol class="most-read-list">
      {% for post in destacadasList %}
      <li><span class="num">{{ loop.index }}</span><a href="{{ post.url }}">{{ post.data.title }}</a></li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  {% if sponsors.items and sponsors.items.length %}
  <div class="widget">
    <h2>Nuestros sponsors</h2>
    {% for s in sponsors.items %}
      {% if s.imagen %}
      <a class="sponsor-banner" href="{{ s.url or '#' }}" target="_blank" rel="noopener noreferrer sponsored" data-no-router style="{% if not loop.last %}margin-bottom:12px;{% endif %}display:block;">
        <img src="{{ s.imagen }}" alt="{{ s.nombre or 'Sponsor' }}" loading="lazy">
      </a>
      {% else %}
      <div class="sponsor-banner" style="{% if not loop.last %}margin-bottom:12px;{% endif %}">
        <div class="placeholder">Espacio publicitario disponible<br>{{ s.nombre }}</div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <div class="widget">
    <h2>Tapas de diarios</h2>
    <ul class="tapas-list">
      <li><a href="https://www.clarin.com/" target="_blank" rel="noopener noreferrer" data-no-router>Clarín →</a></li>
      <li><a href="https://www.lanacion.com.ar/" target="_blank" rel="noopener noreferrer" data-no-router>La Nación →</a></li>
      <li><a href="https://www.eldiariodelaregion.com.ar/" target="_blank" rel="noopener noreferrer" data-no-router>El Litoral / regionales →</a></li>
    </ul>
    <p class="hint" style="margin-top:10px;"><a class="btn btn-outline btn-sm" href="/tapas-de-diarios.html">Ver todas las tapas</a></p>
  </div>

</aside>
