<header class="site-header">
  <div class="container header-top">
    <a href="/" class="brand" aria-label="{{ site.nombre }} {{ site.frecuencia }}, inicio">
      <span class="brand-logo-chip"><img src="/assets/img/logo.png" width="411" height="137" alt="{{ site.nombre }} {{ site.frecuencia }} — El valor de la palabra"></span>
      <span class="brand-freq">{{ site.frecuencia }}</span>
    </a>

    <nav class="main-nav" aria-label="Navegación principal">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Inicio</a>
      <a href="/radio-en-vivo.html"{% if page.url == "/radio-en-vivo.html" %} aria-current="page"{% endif %}>Radio</a>
      <a href="/programacion.html"{% if page.url == "/programacion.html" %} aria-current="page"{% endif %}>Programación</a>
      <a href="/noticias/"{% if page.url == "/noticias/" %} aria-current="page"{% endif %}>Noticias</a>
      <a href="/nosotros.html"{% if page.url == "/nosotros.html" %} aria-current="page"{% endif %}>Nosotros</a>
      <a href="/contacto.html"{% if page.url == "/contacto.html" %} aria-current="page"{% endif %}>Contacto</a>
    </nav>

    <div class="header-actions">
      <a class="live-badge" href="/radio-en-vivo.html" data-play-stream aria-label="Escuchar Radio Éxito en vivo ahora">
        <span class="live-dot" aria-hidden="true"></span><span>EN VIVO</span>
      </a>
      <a class="icon-btn" href="/buscar.html" aria-label="Buscar noticias">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </a>
      {% include "components/theme-toggle.njk" %}
      <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <nav class="subnav" aria-label="Secciones de noticias">
    <ul class="subnav-list container">
      {% for c in categorias %}
      <li><a href="/seccion/{{ c.slug }}/"{% if page.url == "/seccion/" + c.slug + "/" %} aria-current="page"{% endif %}>{{ c.nombre }}</a></li>
      {% endfor %}
      <li><a href="/tapas-de-diarios.html"{% if page.url == "/tapas-de-diarios.html" %} aria-current="page"{% endif %}>Tapas de diarios</a></li>
    </ul>
  </nav>
</header>

<nav id="mobile-nav" class="mobile-nav" aria-label="Menú móvil">
  <ul>
    <li><a href="/">Inicio</a></li>
    <li><a href="/radio-en-vivo.html">Radio en vivo</a></li>
    <li><a href="/programacion.html">Programación</a></li>
    <li><a href="/noticias/">Noticias</a></li>
    <li><a href="/buscar.html">Buscar</a></li>
    {% for c in categorias %}
    <li class="mobile-sub"><a href="/seccion/{{ c.slug }}/">{{ c.nombre }}</a></li>
    {% endfor %}
    <li class="mobile-sub"><a href="/tapas-de-diarios.html">Tapas de diarios</a></li>
    <li><a href="/nosotros.html">Nosotros</a></li>
    <li><a href="/equipo.html">Equipo</a></li>
    <li><a href="/publicidad.html">Publicidad</a></li>
    <li><a href="/contacto.html">Contacto</a></li>
  </ul>
</nav>
