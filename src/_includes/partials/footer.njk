<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/"><span class="brand-name">{{ site.nombre }}</span><span class="brand-freq">{{ site.frecuencia }}</span></a>
        <p style="margin-top:12px;">{{ site.eslogan }}. Música, noticias y compañía para toda la región, las 24 horas.</p>
        <div class="social-row">
          {% if contacto.facebook %}<a href="{{ contacto.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en Facebook" data-no-router>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg>
          </a>{% endif %}
          {% if contacto.instagram %}<a href="{{ contacto.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en Instagram" data-no-router>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>{% endif %}
          {% if contacto.youtube %}<a href="{{ contacto.youtube }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en YouTube" data-no-router>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.6-.5-5.3a3 3 0 00-2.1-2.1C18.7 4 12 4 12 4s-6.7 0-8.4.6a3 3 0 00-2.1 2.1C1 8.4 1 12 1 12s0 3.6.5 5.3a3 3 0 002.1 2.1C5.3 20 12 20 12 20s6.7 0 8.4-.6a3 3 0 002.1-2.1c.5-1.7.5-5.3.5-5.3zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
          </a>{% endif %}
          {% if contacto.twitter %}<a href="{{ contacto.twitter }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en X" data-no-router>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.6 8.7L23.3 22H16.7l-5.2-6.8L5.5 22H2.4l8.1-9.3L1.1 2h6.8l4.7 6.2L18.9 2zm-1.2 18h1.7L7.4 4h-1.8l12.1 16z"/></svg>
          </a>{% endif %}
          {% if contacto.whatsapp %}<a href="{{ contacto.whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en WhatsApp" data-no-router>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.7 14.2c-.3.7-1.4 1.3-2 1.4-.5.1-1.2.2-3.8-.8-3.2-1.3-5.3-4.5-5.5-4.7-.2-.2-1.3-1.7-1.3-3.3s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .5 0 .7.5.3.7 1 2.3 1 2.5.1.2.1.4 0 .6-.1.2-.2.3-.4.5l-.5.6c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.9.9 2.2 1.1.3.1.5.2.6.3.1.2.1.9-.2 1.6z"/></svg>
          </a>{% endif %}
        </div>
      </div>

      <div>
        <h4>Secciones</h4>
        <ul>
          {% for c in categorias | limitar(5) %}
          <li><a href="/seccion/{{ c.slug }}/">{{ c.nombre }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div>
        <h4>Sitio</h4>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/radio-en-vivo.html">Radio en vivo</a></li>
          <li><a href="/tapas-de-diarios.html">Tapas de diarios</a></li>
          <li><a href="/nosotros.html">Nosotros</a></li>
        </ul>
      </div>

      <div>
        <h4>Contacto</h4>
        <ul>
          {% if contacto.whatsapp %}<li><a href="{{ contacto.whatsapp }}" target="_blank" rel="noopener noreferrer" data-no-router>WhatsApp{% if contacto.whatsappTexto %}: {{ contacto.whatsappTexto }}{% endif %}</a></li>{% endif %}
          {% if contacto.email %}<li><a href="mailto:{{ contacto.email }}">{{ contacto.email }}</a></li>{% endif %}
          {% if contacto.direccion %}<li>{{ contacto.direccion }}</li>{% endif %}
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <span>© <span id="year">2026</span> {{ site.nombre }} {{ site.frecuencia }}. Todos los derechos reservados.</span>
      <nav aria-label="Enlaces legales">
        <a href="/legal/privacidad.html">Privacidad</a> ·
        <a href="/legal/terminos.html">Términos y condiciones</a> ·
        <a href="/legal/cookies.html">Cookies</a> ·
        <a href="/legal/reembolsos.html">Reembolsos</a>
      </nav>
    </div>
  </div>
</footer>
