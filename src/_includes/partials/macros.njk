{% macro articleCard(post, size) %}
<a class="card{% if size %} card-{{ size }}{% endif %}" href="{{ post.url }}">
  <div class="card-media">
    {% if post.data.imagen %}
      <img src="{{ post.data.imagen }}" alt="{{ post.data.imagenAlt or post.data.title }}" loading="lazy">
    {% else %}
      <span class="placeholder">{{ site.nombre }} {{ site.frecuencia }}</span>
    {% endif %}
  </div>
  <div class="card-body">
    <span class="card-tag">{{ post.data.categoria | nombreCategoria(categorias) }}</span>
    <h3>{{ post.data.title }}</h3>
    {% if post.data.resumen and size == "lg" %}<p class="card-excerpt">{{ post.data.resumen }}</p>{% endif %}
    <span class="card-date">{{ post.date | fechaLarga }}</span>
  </div>
</a>
{% endmacro %}
