<!DOCTYPE html>
<html lang="es">
<head>
<script>
  // Evita el "flash" de tema incorrecto: corre antes de pintar la página.
  (function () {
    try {
      var mode = localStorage.getItem("radioexito-theme") || "system";
      var sysLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
      var effective = mode === "system" ? (sysLight ? "light" : "dark") : mode;
      document.documentElement.setAttribute("data-theme", effective);
      document.documentElement.setAttribute("data-theme-mode", mode);
    } catch (e) { /* si falla, se queda con el tema oscuro por defecto del CSS */ }
  })();
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or (site.nombre + " " + site.frecuencia) }}{% if title %} — {{ site.nombre }} {{ site.frecuencia }}{% endif %}</title>
<meta name="description" content="{{ description or site.eslogan }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or (site.nombre + ' ' + site.frecuencia) }}">
<meta property="og:description" content="{{ description or site.eslogan }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage }}">{% else %}<meta property="og:image" content="{{ site.url }}/assets/img/logo.png">{% endif %}
<meta property="og:locale" content="es_AR">
<meta name="theme-color" content="#0b0b0c">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
{% if jsonLd %}<script type="application/ld+json">{{ jsonLd | safe }}</script>{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ (site.nombre + " " + site.frecuencia) | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "logo": {{ (site.url + "/assets/img/logo.png") | dump | safe }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ (site.nombre + " " + site.frecuencia) | dump | safe }},
  "url": {{ site.url | dump | safe }}
}
</script>
</head>
<body>
<a class="skip-link" href="#main-content">Saltar al contenido principal</a>

{% include "partials/header.njk" %}

<main id="main-content">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}
{% include "partials/player.njk" %}
{% include "partials/whatsapp-float.njk" %}
{% include "partials/cookie-banner.njk" %}

<script>
  window.SITE_CONFIG = {
    streamUrl: {{ site.streamUrl | dump | safe }},
    streamUrlSSL: {{ (site.streamUrlSSL or "") | dump | safe }},
    nombre: {{ site.nombre | dump | safe }},
    frecuencia: {{ site.frecuencia | dump | safe }},
    gaId: {{ (gaId or "") | dump | safe }}
  };
</script>
<script src="/assets/js/main.js" defer></script>
<script>(function(){var y=document.getElementById("year");if(y){y.textContent=new Date().getFullYear();}})();</script>
</body>
</html>
