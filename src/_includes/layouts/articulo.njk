---
layout: layouts/base.njk
---
{% import "partials/macros.njk" as m %}
<article>
  <div class="container article-header">
    <span class="card-tag">{{ categoria | nombreCategoria(categorias) }}</span>
    <h1>{{ title }}</h1>
    <p class="article-meta">Publicado el {{ date | fechaLarga }}</p>
    {% if imagen %}
    <img class="article-cover" src="{{ imagen }}" alt="{{ imagenAlt or title }}">
    {% endif %}
  </div>
  <div class="container article-body">
    {{ content | safe }}
  </div>

  {% set relacionadas = collections.noticias | porCategoria(categoria) | limitar(4) %}
  {% if relacionadas.length %}
  <div class="container section" style="border-bottom:none; padding-top:0;">
    <h2 class="section-title">Más de {{ categoria | nombreCategoria(categorias) }}</h2>
    <div class="news-grid">
      {% for post in relacionadas %}
        {% if post.url != page.url %}{{ m.articleCard(post) }}{% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</article>
