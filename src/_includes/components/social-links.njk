{# Redes sociales oficiales (sólo las cargadas en contacto.json). Variable opcional: socialSize #}
<div class="social-row">
  {% if contacto.instagram %}<a href="{{ contacto.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en Instagram" data-no-router><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>{% endif %}
  {% if contacto.facebook %}<a href="{{ contacto.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en Facebook" data-no-router><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg></a>{% endif %}
  {% if contacto.youtube %}<a href="{{ contacto.youtube }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en YouTube" data-no-router><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.6-.5-5.3a3 3 0 00-2.1-2.1C18.7 4 12 4 12 4s-6.7 0-8.4.6a3 3 0 00-2.1 2.1C1 8.4 1 12 1 12s0 3.6.5 5.3a3 3 0 002.1 2.1C5.3 20 12 20 12 20s6.7 0 8.4-.6a3 3 0 002.1-2.1c.5-1.7.5-5.3.5-5.3zM10 15.5v-7l6 3.5-6 3.5z"/></svg></a>{% endif %}
  {% if contacto.twitter %}<a href="{{ contacto.twitter }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en X" data-no-router><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.6 8.7L23.3 22H16.7l-5.2-6.8L5.5 22H2.4l8.1-9.3L1.1 2h6.8l4.7 6.2L18.9 2zm-1.2 18h1.7L7.4 4h-1.8l12.1 16z"/></svg></a>{% endif %}
  {% if contacto.tiktok %}<a href="{{ contacto.tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en TikTok" data-no-router><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8A4.3 4.3 0 0115.5 3h-3.1v12.4a2.6 2.6 0 11-1.9-2.5V9.7a5.7 5.7 0 105 5.7V9a7.3 7.3 0 004.3 1.4V7.3a4.3 4.3 0 01-3.2-1.5z"/></svg></a>{% endif %}
  {% if contacto.whatsapp %}<a href="{{ contacto.whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="{{ site.nombre }} en WhatsApp" data-no-router><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.7 14.2c-.3.7-1.4 1.3-2 1.4-.5.1-1.2.2-3.8-.8-3.2-1.3-5.3-4.5-5.5-4.7-.2-.2-1.3-1.7-1.3-3.3s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .5 0 .7.5.3.7 1 2.3 1 2.5.1.2.1.4 0 .6-.1.2-.2.3-.4.5l-.5.6c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.9.9 2.2 1.1.3.1.5.2.6.3.1.2.1.9-.2 1.6z"/></svg></a>{% endif %}
