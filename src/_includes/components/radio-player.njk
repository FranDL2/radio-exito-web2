{# Reproductor persistente: vive FUERA de <main>, así el audio no se corta al navegar. #}
<div class="player-bar" role="region" aria-label="Reproductor de radio en vivo">
  <div class="container player-inner">
    <button id="player-toggle" class="player-toggle" type="button" aria-pressed="false" aria-label="Reproducir transmisión en vivo">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    </button>

    <div class="player-meta">
      <div class="player-live"><span class="live-dot" aria-hidden="true"></span><span>EN VIVO</span><span class="player-sep" aria-hidden="true">·</span><span class="player-status" id="player-status-text" aria-live="polite">En pausa</span></div>
      <div class="player-title">{{ site.nombre | upper }} {{ site.frecuencia }}</div>
      <div class="player-now" id="player-now" hidden>
        <span class="player-now-label">Ahora suena:</span> <span id="player-now-text"></span>
      </div>
      <div class="player-program" id="player-program" hidden>
        <span class="player-now-label">Programa:</span> <span id="player-program-text"></span>
      </div>
      <div class="player-error" id="player-error" role="status"></div>
    </div>

    <div class="player-mini-wave" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <div class="player-volume">
      <button id="player-mute" class="player-icon-btn" type="button" aria-pressed="false" aria-label="Silenciar">
        <svg class="icon-vol" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9H4zm11.5 3a4.5 4.5 0 00-2.5-4v8a4.5 4.5 0 002.5-4z"/></svg>
        <svg class="icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9H4zm12.6 3l2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z"/></svg>
      </button>
      <label for="player-volume" class="visually-hidden">Volumen</label>
      <input type="range" id="player-volume" min="0" max="1" step="0.01" value="0.85">
    </div>

    <button id="player-expand" class="player-icon-btn" type="button" aria-expanded="false" aria-controls="player-panel" aria-label="Abrir reproductor ampliado">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
    </button>
  </div>

  <div id="player-panel" class="player-panel" role="dialog" aria-label="Reproductor ampliado" hidden>
    <div class="container player-panel-inner">
      <img class="player-panel-logo" src="/assets/img/logo.png" width="411" height="137" alt="{{ site.nombre }} {{ site.frecuencia }} — El valor de la palabra" loading="lazy" decoding="async">
      <img id="player-cover" alt="" width="64" height="64" hidden>
      <p class="player-panel-freq">{{ site.frecuencia }} FM · La Cruz, Corrientes</p>
      <p class="player-panel-now" id="player-panel-now"></p>
      <p class="player-panel-program" id="player-panel-program"></p>
      <div class="player-panel-actions">
        <a class="btn btn-outline btn-sm" href="/radio-en-vivo.html">Ir a Radio en vivo</a>
        <a class="btn btn-outline btn-sm" href="/programacion.html">Ver programación</a>
      </div>
    </div>
  </div>

  <audio id="radio-audio" preload="none"></audio>
</div>
