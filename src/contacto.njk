---
permalink: "/contacto.html"
layout: layouts/base.njk
title: "Contacto"
description: "Comunicate con Radio Éxito 105.1: WhatsApp, redes sociales y ubicación en La Cruz, Corrientes."
---
<section class="section" style="padding-top:48px; border-bottom:none;">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Contacto</span>
      <h1 class="mt-0">Hablemos</h1>
      <p class="lead">¿Querés mandar un saludo, avisar algo a la comunidad, pedir un tema o anunciar en la radio? Elegí el medio que prefieras.</p>
    </div>

    <div class="grid-2">
      <div>
        <ul class="contact-list">
          {% if contacto.whatsapp %}
          <li>
            <span class="icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.7 14.2c-.3.7-1.4 1.3-2 1.4-.5.1-1.2.2-3.8-.8-3.2-1.3-5.3-4.5-5.5-4.7-.2-.2-1.3-1.7-1.3-3.3s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .5 0 .7.5.3.7 1 2.3 1 2.5.1.2.1.4 0 .6-.1.2-.2.3-.4.5l-.5.6c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.9.9 2.2 1.1.3.1.5.2.6.3.1.2.1.9-.2 1.6z"/></svg></span>
            <div>
              <a href="{{ contacto.whatsapp }}" target="_blank" rel="noopener noreferrer" data-no-router>WhatsApp{% if contacto.whatsappTexto %}: {{ contacto.whatsappTexto }}{% endif %}</a>
              <p class="hint" style="margin:2px 0 0;">Respuesta en el horario de transmisión</p>
            </div>
          </li>
          {% endif %}
          {% if contacto.telefono %}
          <li>
            <span class="icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.7A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.5 2.1L8 9.7a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.9.3 1.8.5 2.7.6a2 2 0 011.7 2z"/></svg></span>
            <div><a href="tel:{{ contacto.telefono }}">{{ contacto.telefono }}</a></div>
          </li>
          {% endif %}
          {% if contacto.email %}
          <li>
            <span class="icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8l9 6 9-6M4 6h16v12H4z"/></svg></span>
            <div><a href="mailto:{{ contacto.email }}">{{ contacto.email }}</a></div>
          </li>
          {% endif %}
          <li>
            <span class="icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <div>
              <span style="font-weight:600;">{{ contacto.direccion }}</span>
              <p class="hint" style="margin:2px 0 0;">Dirección exacta del estudio disponible a pedido por WhatsApp</p>
            </div>
          </li>
        </ul>

        <h3 style="margin-bottom:10px;">Seguinos</h3>
        {% include "components/social-links.njk" %}

        <iframe class="map-frame" style="margin-top:26px;" loading="lazy" title="Ubicación de {{ site.nombre }} {{ site.frecuencia }}, La Cruz, Corrientes"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-56.647293%2C-29.176365%2C-56.638693%2C-29.170365&layer=mapnik&marker=-29.173365%2C-56.642993">
        </iframe>
      </div>

      <div>
        <form id="contact-form" name="contacto" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="contacto">
          <p class="visually-hidden">
            <label>No completar este campo si sos una persona: <input name="bot-field"></label>
          </p>
          <div class="form-field">
            <label for="name">Nombre y apellido</label>
            <input type="text" id="name" name="name" required autocomplete="name" aria-describedby="name-error">
            <span id="name-error" class="field-error" role="alert"></span>
          </div>
          <div class="form-field">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" required autocomplete="email" aria-describedby="email-error">
            <span id="email-error" class="field-error" role="alert"></span>
          </div>
          <div class="form-field">
            <label for="message">Mensaje</label>
            <textarea id="message" name="message" required aria-describedby="message-error"></textarea>
            <span id="message-error" class="field-error" role="alert"></span>
          </div>
          <div class="consent-field">
            <input type="checkbox" id="contact-consent" name="consent" required aria-describedby="contact-consent-error">
            <label for="contact-consent">
              Acepto que mis datos sean tratados según la <a href="/legal/privacidad.html">Política de Privacidad</a>
              de {{ site.nombre }} {{ site.frecuencia }} para ser contactado/a en relación a este mensaje.
            </label>
          </div>
          <span id="contact-consent-error" class="field-error" role="alert"></span>
          <button type="submit" class="btn btn-primary">Enviar mensaje</button>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>
