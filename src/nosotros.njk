---
permalink: "/nosotros.html"
layout: layouts/base.njk
title: "Nosotros"
description: "Conocé a Radio Éxito 105.1: radio y portal de noticias de La Cruz, Corrientes."
---
<section class="section" style="padding-top:48px;">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Institucional</span>
      <h1 class="mt-0">{{ nosotros.titulo }}</h1>
      <p class="lead">{{ nosotros.intro }}</p>
    </div>
    <div class="grid-2">
      <div class="info-card">
        <h3>{{ nosotros.misionTitulo }}</h3>
        <p>{{ nosotros.misionTexto }}</p>
      </div>
      <div class="info-card">
        <h3>{{ nosotros.compromisoTitulo }}</h3>
        <p>{{ nosotros.compromisoTexto }}</p>
      </div>
    </div>
  </div>
</section>

<section class="section" style="border-bottom:none;">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Datos institucionales</span>
      <h2 class="mt-0">Información de la emisora</h2>
    </div>
    <div class="grid-3">
      <div class="info-card"><h3>Frecuencia</h3><p>FM {{ site.frecuencia }} MHz</p></div>
      <div class="info-card"><h3>Localidad</h3><p>{{ contacto.direccion }}</p></div>
      <div class="info-card"><h3>Alcance</h3><p>Transmisión FM local y streaming en vivo para todo el mundo a través de este sitio.</p></div>
    </div>
  </div>
</section>

<section class="section" style="border-bottom:none;">
  <div class="container grid-2">
    <div>
      <h3>Más sobre la radio</h3>
      <ul class="check-list">
        <li><a href="/equipo.html">Conocé a nuestro equipo</a></li>
        <li><a href="/programacion.html">Ver programación</a></li>
        <li><a href="/publicidad.html">Anunciá con nosotros</a></li>
        <li><a href="/contacto.html">Contacto</a></li>
      </ul>
    </div>
    <div>
      <h3>Seguinos</h3>
      {% include "components/social-links.njk" %}
    </div>
  </div>
</section>
